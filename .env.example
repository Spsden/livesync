# Copy to .env and fill in. .env is gitignored.

POSTGRES_DB=livesync
POSTGRES_USER=livesync
POSTGRES_PASSWORD=change-me-please

# Where the app is mounted: empty = domain root, /livesync = under a path.
# This is a BUILD-time value as well — the client bakes it in:
#   BASE_PATH=/livesync npm run build
BASE_PATH=

# Host ports, bound to 127.0.0.1 only.
# APP_PORT is where you browse the Compose stack. PG_PORT is where Postgres is
# published on the host (bare-metal runs connect through it too).
APP_PORT=3000
PG_PORT=5433

# Per-file upload ceiling in bytes (default 25 MB).
MAX_FILE_BYTES=26214400

# --- Bare metal only (PM2 / npm start / npm run gc) -------------------------
# Docker ignores these: compose sets PORT, DATABASE_URL and DATA_DIR itself.
# The connection string is built from POSTGRES_* above, so only set what differs.
# PORT=3002
# HOST=127.0.0.1
# DATA_DIR=./data
# DB_HOST=127.0.0.1
# DB_PORT=5433

# From Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
# Only needed when running the cloudflared service with `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=
